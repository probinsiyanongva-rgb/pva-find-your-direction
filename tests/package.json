{
  "name": "pva-find-your-direction-tests",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "description": "Regression tests for Stage 4. Lives outside public/ so nothing here is deployed; kept out of the repo root so the Cloudflare build is unchanged.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec \"unit/*.test.mjs\" \"pages/*.test.mjs\"",
    "test:unit": "node --test --test-reporter=spec \"unit/*.test.mjs\"",
    "test:pages": "node --test --test-reporter=spec \"pages/*.test.mjs\"",
    "golden": "node tools/make-golden.mjs",
    "serve": "node e2e/serve.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "jsdom": "27.4.0"
  }
}
